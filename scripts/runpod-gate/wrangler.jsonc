{
  "name": "openseo-gate",
  "main": "index.ts",
  "compatibility_date": "2025-09-02",
  "workers_dev": true,
  // Runs the idle check once a minute.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "POD_ID": "jl8n558l4bwyu3",
    "POD_PORT": "3001",
    "IDLE_MINUTES": "5",
  },
  // Stores the time of the last request. Created in the user's Cloudflare
  // account as "openseo-gate-state". Secret: RUNPOD_API_KEY.
  "kv_namespaces": [
    { "binding": "STATE", "id": "9a2d9ba0f62640c3aa406781ea6986d3" },
  ],
}
