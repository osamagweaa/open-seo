{
  "name": "openseo-gate",
  "main": "index.ts",
  "compatibility_date": "2025-09-02",
  "workers_dev": true,
  // Runs the idle check once a minute.
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "POD_ID": "jl8n558l4bwyu3",
    "POD_PORT": "3001",
    "IDLE_MINUTES": "5",
  },
  // The namespace is created on first deploy. Secret: RUNPOD_API_KEY.
  "kv_namespaces": [{ "binding": "STATE" }],
}
